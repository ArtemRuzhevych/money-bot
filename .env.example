# Copy to .env in the host's server root (next to launcher.py) and fill in. Restart after changes.

# Deploy: the launcher downloads this repo's deploy branch.
GITHUB_REPO=your-name/money-bot
# Only for a private repo: fine-grained token, this repo only, Contents read-only.
GITHUB_TOKEN=
# DEPLOY_BRANCH=deploy
# POLL_SECONDS=300

# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/home/container/service-account.json

# Optional features
CLAUDE_CODE_OAUTH_TOKEN=
MONOBANK_TOKEN=

# Optional settings
# TIMEZONE=Europe/Warsaw
# Wallet card name text = account, comma separated
# CARD_ACCOUNTS=mbank=mbank,revolut=revolut
# Account for "blik 50 shop" entries (default: blik)
# BLIK_ACCOUNT=mbank
# LOG_LEVEL=INFO
